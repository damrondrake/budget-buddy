# Base URL of the backend API.
VITE_API_URL=http://localhost:8000

# Sentry error tracking (https://sentry.io). Leave blank to disable — errors
# are only reported to Sentry when this is set, so local dev stays clean. See
# the README for how to get a free DSN.
VITE_SENTRY_DSN=

# Stripe publishable key (pk_test_... / pk_live_...). Safe to expose in the
# client. Used for Stripe.js; billing redirects use server-created session URLs.
VITE_STRIPE_PUBLISHABLE_KEY=
