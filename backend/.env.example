SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./budget_buddy.db
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# Resend transactional email (https://resend.com) for password reset + partner invites.
# Leave blank in local dev: emails are skipped/logged and tokens are returned in the API response.
RESEND_API_KEY=
# Optional: verified sender. Defaults to Resend's shared sandbox (onboarding@resend.dev).
RESEND_FROM_EMAIL=BudgetBuddy <onboarding@resend.dev>
# Base URL used in email links (reset/invite). Defaults to the production site.
FRONTEND_URL=https://budget-buddy-app.com

# Sentry error tracking (https://sentry.io). Leave blank to disable — errors
# are only reported to Sentry when this is set. See the README for how to get a
# free DSN.
SENTRY_DSN=
